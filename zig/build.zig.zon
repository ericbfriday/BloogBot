.{
    .name = .bloogbot_zig,
    .version = "0.0.0",
    // Zig 0.14+ introduced the `.winapi` calling convention and the new
    // build-system `b.path(...)` LazyPath API used in build.zig.
    // Zig 0.16 changed std.process (argsAlloc removed; main takes Init).
    .minimum_zig_version = "0.16.0",
    // Zig generates a fingerprint warning on first build and tells you the
    // exact value to paste here. Until a real one is generated, leave the
    // placeholder; `zig build` will print the substitute it expects.
    .fingerprint = 0xd852_f806_962e_9be0,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
    .dependencies = .{},
}
